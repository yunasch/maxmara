<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

<record id="action_ir_attachment_wizard" model="ir.actions.act_window">
    <field name="name">Adjuntar Archivo</field>
    <field name="res_model">ir.attachment.wizard</field>
    <field name="view_mode">form</field>
    <field name="target">new</field>
</record>

<record id="ir_attachment_wizard_form" model="ir.ui.view">
    <field name="name">ir.attachment.wizard.form</field>
    <field name="model">ir.attachment.wizard</field>
    <field name="arch" type="xml">
        <form string="Adjuntar Archivo">
            <group>
                <field name="attachment" filename="filename" widget="binary"/>
                <field name="filename" invisible="1"/>
            </group>
            <footer>
                <button name="action_upload_file" type="object" string="Subir" class="btn-primary"/>
                <button string="Cancelar" class="btn-secondary" special="cancel"/>
            </footer>
        </form>
    </field>
</record>

<record model="ir.ui.view" id="view_product_template_button_inherit">
    <field name="name">product.template.button.inherit</field>
    <field name="model">product.template</field>
    <field name="inherit_id" ref="product.product_template_tree_view"/>
    <field name="arch" type="xml">
        <xpath expr="//tree/header" position="inside">
            <button name="action_attach_file" type="object" class="btn-primary" string="Importar Productos"/>

        </xpath>
    </field>
</record>
    </data>
</odoo>